# Configuração do login com GitHub no #/admin.
# Nenhum destes valores é secreto: são públicos por natureza (o client secret do GitHub App
# fica só no Cloudflare Worker, nunca aqui). Sem eles preenchidos, o admin mostra
# "Admin não configurado" e o site público continua funcionando normalmente.

# URL do worker publicado (cloudflare-worker/github-oauth-worker.js), sem barra no final.
VITE_GITHUB_OAUTH_WORKER_URL=

# Usuário do GitHub autorizado a usar o #/admin (seu login, ex.: jessfuhar).
VITE_GITHUB_ADMIN_USERNAME=
